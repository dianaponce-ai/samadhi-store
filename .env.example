# ─── Samadhi Style · configuración ───────────────────────────────
# Copiá este archivo como ".env" y completá tus datos.
# Nunca subas el archivo .env a internet ni lo compartas por chat.

# Dirección pública del sitio (sin barra al final).
# Mercado Pago la usa para volver a tu tienda y avisar los pagos.
PUBLIC_URL=https://www.samadhistyle.com.ar
PORT=3000

# Clave larga y aleatoria para firmar las sesiones del panel.
# Generá una con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Primer usuario del panel (se crea solo si todavía no hay ninguno).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ─── Mercado Pago ────────────────────────────────────────────────
# Tus integraciones > tu aplicación > Credenciales de producción.
# Si lo dejás vacío, la tienda funciona en "modo prueba" con un pago simulado.
MP_ACCESS_TOKEN=
# Tus integraciones > Webhooks > Configurar notificaciones > Clave secreta.
MP_WEBHOOK_SECRET=

# ─── Andreani ────────────────────────────────────────────────────
# Credenciales de la API que te da tu ejecutivo de cuenta de Andreani.
# Si las dejás vacías, los envíos se cotizan con una tabla de prueba.
ANDREANI_USER=
ANDREANI_PASSWORD=
ANDREANI_CLIENTE=
# Número de contrato para envío a domicilio y para envío a sucursal.
ANDREANI_CONTRATO_DOMICILIO=
ANDREANI_CONTRATO_SUCURSAL=
# "prod" para producción, "qa" para el entorno de pruebas de Andreani.
ANDREANI_ENV=prod

# ─── Emails (opcional) ───────────────────────────────────────────
# Para que salgan los emails automáticos (pedidos, pagos, envíos y recordatorios).
# Ejemplo Gmail: smtps://tucuenta%40gmail.com:CLAVE_DE_APLICACION@smtp.gmail.com:465
SMTP_URL=
# O en lugar de SMTP: clave de Resend (https://resend.com → API Keys). Con dominio verificado, MAIL_FROM puede ser de la tienda.
RESEND_API_KEY=
MAIL_FROM="Samadhi Style <hola@samadhistyle.com.ar>"
# Dónde te llegan los avisos de pedidos nuevos.
STORE_NOTIFY_EMAIL=

# ─── Lince / Dragonfish (opcional) ───────────────────────────────
# Opción A · agente en la PC del local: inventá una clave larga y usá la misma en lince/samadhi-lince.config.ps1
LINCE_SYNC_SECRET=
# Opción B · conexión directa (sólo si la API de Dragonfish es accesible desde internet)
DRAGONFISH_URL=
DRAGONFISH_ID_CLIENTE=
DRAGONFISH_TOKEN=
DRAGONFISH_STOCK_PATH=ConsultaStockYPrecios

# ─── Probador con IA de Google Gemini (opcional, el que viene elegido) ──
# Clave de Google AI Studio (aistudio.google.com → Get API key), con facturación activa.
# Sin clave, la tienda usa el probador propio (el que corre en el navegador).
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# ─── Probador virtual con FASHN (opcional) ───────────────────────
# Clave de https://fashn.ai (Settings → API). 1 crédito por imagen generada.
FASHN_API_KEY=

# ─── Reseñas de Google (opcional) ────────────────────────────────
# Clave de Google Cloud con "Places API (New)" activada, y el Place ID de la ficha del local.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
